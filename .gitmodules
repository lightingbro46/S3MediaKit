[submodule "S3ToolKit"]
	path = 3rdpart/S3ToolKit
	url = https://github.com/lightingbro46/S3ToolKit.git
	branch = develop
[submodule "www/webassist"]
	path = www/webassist
	url = https://github.com/lightingbro46/s3m_webassist.git
[submodule "3rdpart/jwt-cpp"]
	path = 3rdpart/jwt-cpp
	url = https://github.com/Thalhammer/jwt-cpp.git
[submodule "3rdpart/onvif"]
	path = 3rdpart/onvif
	url = https://github.com/lightingbro46/onvif.git
[submodule "3rdpart/jsoncpp"]
	path = 3rdpart/jsoncpp
	url = https://github.com/open-source-parsers/jsoncpp.git
[submodule "3rdpart/media-server"]
	path = 3rdpart/media-server
	url = https://github.com/ireader/media-server.git
[submodule "3rdpart/nv-codec-headers"]
	path = 3rdpart/nv-codec-headers
	url = https://github.com/FFmpeg/nv-codec-headers.git
[submodule "3rdpart/FFmpeg"]
	path = 3rdpart/FFmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
	shallow = true
[submodule "3rdpart/aws-sdk-cpp"]
	path = 3rdpart/aws-sdk-cpp
	url = https://github.com/aws/aws-sdk-cpp.git
	shallow = true
